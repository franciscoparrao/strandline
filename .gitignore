# Rust
/target/
**/*.rs.bk

# Escenas satelitales descargadas (pesadas, regenerables vía GEE con
# spike/scripts/01_download_scenes.py). Los resultados del spike
# (spike/results/) sí se versionan como evidencia.
/spike/data/
/data/

# Symlink a los modelos de CoastSat en otro proyecto (ruta absoluta,
# no portable). El JSON de pesos ya está embebido en strandline-core/models/.
/spike/classification

# Settings locales de Claude Code (específicos de la máquina)
.claude/settings.local.json

# Artefactos de validación regenerables (shorelines sintéticas, salidas)
/spike/transects/shorelines_synth.csv
/spike/transects/cross_rust.csv
/spike/rates/intersections.csv
/spike/rates/intersections_raw.csv

# Temporales
*.pyc
__pycache__/
/spike/constitucion/intersections_clean.csv

# Ventanas traídas de Planetary Computer (regenerables con strandline fetch)
/spike/mpc/*.tif

# Datos del experimento de reentrenamiento SR, que no se adoptó (adenda
# 2026-07-16). Intermedios regenerables con pseudo_label_sr.py.
/spike/classifier_sr/training_data_auto/

# material de terceros / interno (no publicar)
spike/algarrobo/
spike/slope_field/*_profiles_2023.csv
